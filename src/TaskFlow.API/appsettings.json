{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=taskflow;Username=taskflow"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "TaskFlowAPI",
    "Audience": "TaskFlowClient",
    "ExpirationInMinutes": 1440
  },
  "Smtp": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "Security": "Auto",
    "FromAddress": "noreply@taskflow.dev",
    "FromName": "TaskFlow"
  },
  "Reminders": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "WindowHours": 24
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
